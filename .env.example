# ==============================================================================
# Predict-Ai / PrediCore Environment Variables Template
# ==============================================================================

# Application Environment (development, staging, production, test)
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
SECRET_KEY=change_this_to_a_random_secure_hex_token_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (Neon PostgreSQL)
# Pooled connection URL (used by FastAPI runtime via PgBouncer)
DATABASE_URL=postgresql+psycopg://username:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Direct connection URL (used by Alembic migrations and CLI administrative commands)
DATABASE_URL_DIRECT=postgresql+psycopg://username:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Local/Test Database URL (used for pytest and local docker-compose test runner)
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/predict_ai_test

# Database Connection Timeout (in seconds; ~10s default handles Neon serverless cold starts, set to 2 for fast test failure)
DB_CONNECT_TIMEOUT=10

# CORS Allowed Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://predict-ai.vercel.app

# Rate Limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_SCORING=5/minute
RATE_LIMIT_DEFAULT=120/minute

# Model Artifacts Directory (relative to backend root or absolute)
MODEL_ARTIFACTS_DIR=model_artifacts

# Initial Admin Seed Credentials
INITIAL_ADMIN_EMAIL=admin@predicore.internal
INITIAL_ADMIN_PASSWORD=AdminSecurePass123!
INITIAL_ENGINEER_EMAIL=engineer@predicore.internal
INITIAL_ENGINEER_PASSWORD=EngineerSecurePass123!
